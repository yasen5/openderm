# Shared client configuration (Pi 2 and operator shells)
# Generate a unique value with:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Use the same secret on both Pis. Never commit the real value.
OPENDERM_CONTROL_TOKEN=replace-with-a-unique-random-token
GANTRY_SERVER_URL=http://openderm-gantry.local:8090
PICO_PORT=socket://openderm-gantry.local:8095
RX_AXIS_SERVER_URL=http://127.0.0.1:8091
OPENDERM_COLLISION_MODE=enforce

# Raspberry Pi 1: Klipper/Moonraker owns X only.
MOONRAKER_WS_URL=ws://127.0.0.1:7125/websocket
GANTRY_CONTROLLED_STEPPERS=stepper_x,stepper_x1

# Raspberry Pi 2: adjust CAN interfaces only if udev assigns different names.
GANTRY_RX_CAN_INTERFACE=can1
